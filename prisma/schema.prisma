generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole { SUPERADMIN OWNER MANAGER STAFF }
enum AppointmentStatus { PENDING CONFIRMED COMPLETED CANCELLED NO_SHOW }
enum OverrideType { WORKING BLOCKED }
enum NotificationChannel { EMAIL PUSH SMS WHATSAPP }
enum NotificationStatus { PENDING SENT FAILED SKIPPED }
enum PaymentStatus { REQUIRES_PAYMENT PAID REFUNDED FAILED CANCELLED }

enum TenantStatus { TRIAL ACTIVE PAST_DUE SUSPENDED CANCELLED }

model Tenant {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  name                  String
  email                 String
  phone                 String?
  timezone              String   @default("Europe/Zagreb")
  currency              String   @default("EUR")
  status                TenantStatus @default(TRIAL)
  cancellationHours     Int      @default(12)
  slotStepMinutes       Int      @default(15)
  defaultReminderHours  Json?
  allowOnlineBooking    Boolean  @default(true)
  requireDeposit        Boolean  @default(false)
  depositPercent        Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  users                 User[]
  categories            ServiceCategory[]
  services              Service[]
  staff                  StaffProfile[]
  customers              Customer[]
  appointments           Appointment[]
  workingHours           WorkingHour[]
  overrides              ScheduleOverride[]
  subscriptions          PushSubscription[]
  notificationJobs      NotificationJob[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  active       Boolean  @default(true)
  staffProfile StaffProfile?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([tenantId, role])
}

model StaffProfile {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String
  color          String?  @default("#6057ff")
  bio            String?  @db.Text
  bookable       Boolean  @default(true)
  sortOrder      Int      @default(0)
  services       StaffService[]
  workingHours   WorkingHour[]
  breaks         StaffBreak[]
  overrides      ScheduleOverride[]
  appointments   Appointment[]
  slotLocks      AppointmentSlotLock[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([tenantId, bookable])
}

model ServiceCategory {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int      @default(0)
  services  Service[]
  @@index([tenantId, sortOrder])
}

model Service {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name           String
  description    String?  @db.Text
  durationMin    Int
  prepMin        Int      @default(0)
  cleanupMin     Int      @default(0)
  priceCents     Int
  active         Boolean  @default(true)
  onlineBookable Boolean  @default(true)
  sortOrder      Int      @default(0)
  staff          StaffService[]
  appointments   Appointment[]
  @@index([tenantId, active, onlineBookable])
}

model StaffService {
  staffId   String
  serviceId String
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customPriceCents Int?
  customDurationMin Int?
  @@id([staffId, serviceId])
  @@index([serviceId])
}

model WorkingHour {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     StaffProfile? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  weekday   Int
  startMin  Int
  endMin    Int
  active    Boolean @default(true)
  @@index([tenantId, staffId, weekday])
}

model StaffBreak {
  id       String @id @default(cuid())
  staffId  String
  staff    StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  weekday  Int
  startMin Int
  endMin   Int
  active   Boolean @default(true)
  @@index([staffId, weekday])
}

model ScheduleOverride {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     StaffProfile? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  type      OverrideType
  note      String?
  @@index([tenantId, staffId, startsAt, endsAt])
}

model Customer {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String
  notes       String?  @db.Text
  blocked     Boolean  @default(false)
  noShowCount Int      @default(0)
  visitCount  Int      @default(0)
  totalSpentCents Int   @default(0)
  lastVisitAt DateTime?
  appointments Appointment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([tenantId, phone])
  @@index([tenantId, email])
}

model Appointment {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id])
  staffId         String
  staff           StaffProfile @relation(fields: [staffId], references: [id])
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  status          AppointmentStatus @default(CONFIRMED)
  source          String   @default("ONLINE")
  startsAt        DateTime
  endsAt          DateTime
  lockStartsAt    DateTime
  lockEndsAt      DateTime
  priceCents      Int
  depositCents    Int      @default(0)
  notes           String?  @db.Text
  manageTokenHash String?  @db.VarChar(128)
  cancelledAt     DateTime?
  cancelReason    String?
  slotLocks       AppointmentSlotLock[]
  payments        Payment[]
  notificationJobs NotificationJob[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([tenantId, startsAt, status])
  @@index([staffId, startsAt, endsAt])
  @@index([customerId, startsAt])
}

model AppointmentSlotLock {
  id            String @id @default(cuid())
  tenantId      String
  staffId       String
  staff         StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  startsAt      DateTime
  @@unique([staffId, startsAt])
  @@index([tenantId, startsAt])
  @@index([appointmentId])
}

model Payment {
  id            String @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  provider      String @default("STRIPE")
  providerRef   String? @unique
  amountCents   Int
  status        PaymentStatus @default(REQUIRES_PAYMENT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([appointmentId, status])
}

model PushSubscription {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  endpoint  String @db.Text
  p256dh    String @db.Text
  auth      String @db.Text
  userAgent String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, endpoint(length: 191)])
  @@index([tenantId, userId])
}

model NotificationJob {
  id            String @id @default(cuid())
  tenantId      String
  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  channel       NotificationChannel
  kind          String
  recipient     String? @db.Text
  payload       Json
  sendAt        DateTime
  status        NotificationStatus @default(PENDING)
  attempts      Int @default(0)
  lastError     String? @db.Text
  sentAt        DateTime?
  createdAt     DateTime @default(now())
  @@index([status, sendAt])
  @@index([tenantId, appointmentId])
}
